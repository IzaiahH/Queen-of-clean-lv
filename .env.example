# Queen of Clean LV — environment variables
# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.
# Everything without the NEXT_PUBLIC_ prefix stays on the server and is never sent to the browser.

# ─── Database (required) ────────────────────────────────────────────────────────────────
# Postgres connection used by the app at runtime (server-side only).
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543). Local: postgres://postgres@localhost:5432/qoc
DATABASE_URL=postgres://postgres@localhost:5432/qoc
# Direct (non-pooled) connection for migrations and scripts. Supabase: the "Direct connection" or "Session pooler" URI (port 5432).
# Leave empty to use DATABASE_URL.
DATABASE_URL_DIRECT=
# Max connections per server instance (keep small on serverless). Default 5.
DATABASE_POOL_MAX=5

# ─── Public site address (required in production) ─────────────────────────────────────────
# Used to build links in emails (manage-booking and quote links). No trailing slash.
APP_URL=http://localhost:3000

# ─── Staff sign-in ──────────────────────────────────────────────────────────────────────
# "supabase" (recommended in production) or "local" (password hashes stored in this database; good for local dev).
# If unset: supabase when NEXT_PUBLIC_SUPABASE_URL is set, otherwise local.
AUTH_PROVIDER=local
# Supabase project URL and publishable (anon) key: Supabase → Project Settings → API. Safe to expose; RLS denies all direct table access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects call the publishable key the "anon" key; either variable works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Used to create/disable staff logins. Never prefix with NEXT_PUBLIC_, never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ──────────────────────────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`). Salts the hashed IP addresses used for rate limiting
# so raw IPs are never stored.
SESSION_SECRET=change-me-to-a-long-random-string
# Protects /api/cron/daily. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# At least 16 characters in production (`openssl rand -hex 32`).
CRON_SECRET=change-me-to-a-long-random-string

# ─── Email (Resend) ────────────────────────────────────────────────────────────────────
# Without both of these, emails are logged as "Not sent" and the app never claims they were delivered.
# API key: resend.com → API Keys (Sending access is enough).
RESEND_API_KEY=
# Must use a domain you verified in Resend, e.g. "Queen of Clean LV <hello@yourdomain.com>".
EMAIL_FROM=
# Optional: where customer replies go (e.g. the owner's inbox).
EMAIL_REPLY_TO=

# ─── Tests (optional) ──────────────────────────────────────────────────────────────────
# Integration tests rebuild this database from scratch. Its name MUST end in _test.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/qoc_test
# Browser tests run against a running app and add synthetic e2e.*@example.test records to its database.
E2E_BASE_URL=http://localhost:3000
# Defaults to DATABASE_URL. Non-local databases are refused unless E2E_ALLOW_REMOTE_DB=1.
E2E_DATABASE_URL=
# Only needed if Playwright can't find its own Chromium.
PLAYWRIGHT_CHROMIUM_PATH=
